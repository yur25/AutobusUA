{
    "name": "autobusua",
    "version": "1.0.0",
    "description": "AutobusUA - платформа для організації та пошуку міжміських перевезень автобусами по Україні.",
    "main": "dist/main.js",
    "directories": {
        "doc": "docs"
    },
    "scripts": {
        "build": "node scripts/write-build-info.mjs && tsc -p tsconfig.json",
        "start": "node scripts/start-app.mjs",
        "start:dev": "node scripts/write-build-info.mjs && node --enable-source-maps --import @swc-node/register/esm-register --watch scripts/start-dev.mjs",
        "start:prod": "node scripts/start-app.mjs",
        "db:migrate": "npm run build && node scripts/migrate.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "typecheck": "node scripts/write-build-info.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
        "smoke:test": "tsx --test tests/smoke-test.ts",
        "verify": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run smoke:test",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yur25/AutobusUA.git"
    },
    "keywords": [
        "nestjs",
        "typescript",
        "backend"
    ],
    "author": "",
    "license": "ISC",
    "type": "module",
    "bugs": {
        "url": "https://github.com/yur25/AutobusUA/issues"
    },
    "homepage": "https://github.com/yur25/AutobusUA#readme",
    "dependencies": {
        "@nestjs/common": "^12.5.1",
        "@nestjs/core": "^12.5.1",
        "@nestjs/platform-express": "^12.5.1",
        "argon2": "^0.45.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "pg": "^8.23.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nestjs/testing": "^12.5.1",
        "@swc-node/register": "^1.12.1",
        "@swc/core": "^1.16.22",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "@types/pg": "^8.23.1",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.1",
        "prettier": "^3.10.1",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.73.0"
    },
    "lint-staged": {
        "*.{ts,mjs}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.{json,md}": [
            "prettier --write"
        ]
    }
}
